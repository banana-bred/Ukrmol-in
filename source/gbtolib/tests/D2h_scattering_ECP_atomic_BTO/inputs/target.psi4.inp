}

molecule Ar {
    Ar 0 0 0
}

E, wfn = properties('scf', properties=['dipole', 'quadrupole'], return_wfn=True)

wfn.write_molden('ar.molden', do_virtual=True)

# Post-process the Molden file so that it stores the atomic number rather than the screened nuclear charge.
# This is needed for consistency with Molpro and with the expectations of GBTOlib, and maybe even with the
# Molden file format specification itself. The formatting is taken from "psi4/driver/p4util/writer.py" from
# version 1.10 of Psi4.
with open('ar.molden', 'r+') as f:
    text = f.read()
    mol = wfn.molecule()
    for atom in range(0, mol.natom()):
        text = text.replace(f'{mol.symbol(atom):2s}  {atom+1:2d}  {int(mol.Z(atom)):3d}',
                            f'{mol.symbol(atom):2s}  {atom+1:2d}  {int(mol.true_atomic_number(atom)):3d}')
    f.seek(0)
    f.write(text)
