&state
  sname = 'e + H2O_final - doublet A1',
  megul = 70, ! unit to which output is saved
  iscat = 2,  ! no phase correction necessary for target
  iposit = -1, ! positron flag - 0 for electron, -1 for positron
  symtyp = 2, ! D2h, C2v, etc. are of sym. type 2
  qntot  = 2,0,0, ! triplet of numbers, e.g. 1,0,0 means 1 = Singlet, 0 = A1, etc
  nelect = 11, ! number of electrons
  nob  = 266,170,172,112, ! total number of orbitals for each symmetry
  nobe = 133,85,86,56, ! number of electron orbitals for each symmetry
  nobp = 133,85,86,56, ! number of positron orbitals for each symmetry
  nobv = 7,1,2,0, ! number of valent orbitals for each symmetry
  nob0 = 7,1,2,0, ! number of target orbitals for each symmetry
  nrefo = 1, ! Number of quintets in reforb
  reforb = 0,1,11,0,0, ! reference determinant
  lndo = 1000000000, ! memory control
  noex=1,
/
&wfngrp
  gname = 'singlet A1 x continuum^1',
  qntar = 1,0,0, ! coupling control
  nelecg = 11, ! number of electrons to distribute among configurations
  nrefog = 1, ! number of reference determinants
  reforg = 0,1,11,0,0, ! movable electrons
  ndprod = 3, ! number of sets of shells
  nelecp = 2,8,1, ! number of electrons in each set
  nshlp  = 1,3,1,  ! number of shells (triplets) in each set
  pqn  = 0,1,1, 0,2,7, 0,1,1, 0,1,2, 0,141,142, ! orbitals in each shell
  mshl =   0,     0,     1,     2,     0, ! symmetry of shells above 
  npcupf = 1, ! print coupling information
!  lsquare = 0,
/
