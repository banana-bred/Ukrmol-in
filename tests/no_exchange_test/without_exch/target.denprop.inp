&input
  name = 'H2O_final - Transition Moments',
  ipol = 0, ! controls calculation of dipole polarizabilities, 0 = no calculation
  ntgt = 6, ! number of CSF expansions used, this is the number of different output files to be read
  nftsor = 710,730,711,731,712,732, ! unit numbers with output from CONGEN
  ntgtf = 1,2,3,4,5,6, ! defines the set number, on unit NFTG where the CI vectors for this symmetry are to be found.
  ntgtl = 4,3,3,4,3,3, ! defines the sequence number, within the set specified by NTGTF, of the last CI vector to be used
  npflg(9) = 1, ! prints computed moments
  zlast = .true., ! when set to .true. identifies that this card deck is the last in the stack of &INPUT decks.
  ukrmolp_ints = .true., ! commented out if you do not run UKRmol+ suite
/
