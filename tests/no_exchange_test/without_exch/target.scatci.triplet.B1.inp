&input
  megul = 731, ! input from module CONGEN
  nfte = 29, ! Hamiltonian scratch file
  ukrmolp_ints = .true., ! commented out if you do not run UKRmol+ suite
/
&cinorn
  name = 'H2O_final CI calculation - triplet B1',
  nstat = 4, ! number of CI eigenvalues
  nciset = 4, ! index of calculated CI vectors within output file (0 = automatic indexing, but first must be 1)
  igh = 1,
 !memp = 2.5,
/
