&input
  megul = 711, ! input from module CONGEN
  nfte = 29, ! Hamiltonian scratch file
  ukrmolp_ints = .true., ! commented out if you do not run UKRmol+ suite
/
&cinorn
  name = 'H2O_final CI calculation - singlet B1',
  nstat = 3, ! number of CI eigenvalues
  nciset = 3, ! index of calculated CI vectors within output file (0 = automatic indexing, but first must be 1)
  igh = 1,
 !memp = 2.5,
/
