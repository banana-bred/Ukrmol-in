&input
  megul = 714, ! input from module CONGEN
  nfte  = 814, ! Hamiltonian scratch file
  nfti  = 16,  ! molecular integrals
/
&cinorn
  name = 'benzene_plus_scattering CI calculation - singlet B1u',
  nstat = 1,  ! number of CI eigenvalues
  nftw = 26,  ! output file with eigenpairs
  nciset = 9, ! index of calculated CI vectors within output file (0 = automatic indexing, but first must be 1)
  igh = 1,    ! force dense diagonalization
/
