&state
  sname = 'Cl2+e - doublet B1u',
  megul = 724, ! unit to which output is saved
  iscat = 2,  ! no phase correction necessary for target
  iposit = 0, ! positron flag - 0 for electron, -1 for positron
  symtyp = 2, ! D2h, C2v, etc. are of sym. type 2
  qntot  = 2,4,0, ! triplet of numbers, e.g. 1,0,0 means 1 = Singlet, 0 = A1, etc
  nelect = 15, ! number of electrons
  nob  = 51,26,26,24,26,25,25,8, ! total number of orbitals for each symmetry
  nob0 = 2,1,1,0,1,1,1,0, ! number of target orbitals for each symmetry
  nrefo = 6, ! Number of quintets in reforb
  reforb = 0,1,4,0,0, 1,1,2,0,0, 2,1,2,0,0, 4,1,3,0,0, 5,1,2,0,0, 6,1,2,0,0, ! reference determinant
  lndo = 10000000, ! memory control
/
&wfngrp
  gname = 'singlet Ag (ORMAS distribution 1/1) x continuum^1',
  qntar = 1,0,0, ! coupling control
  nelecg = 15, ! number of electrons to distribute among configurations
  nrefog = 6, ! number of reference determinants
  reforg = 0,1,4,0,0, 1,1,2,0,0, 2,1,2,0,0, 4,1,3,0,0, 5,1,2,0,0, 6,1,2,0,0, ! reference determinant
  ndprod = 2, ! number of sets of shells
  nelecp = 14,1, ! number of electrons in each set
  nshlp  = 6,1,  ! number of shells (triplets) in each set
  pqn  = 0,1,2, 0,1,1, 0,1,1, 0,1,1, 0,1,1, 0,1,1, 0,2,3, ! orbitals in each shell
  mshl =   0,     1,     2,     4,     5,     6,     4,   ! symmetry of shells above
  npcupf = 1, ! print coupling information
/
