&state
  sname = 'Ar - singlet Ag',
  megul = 710, ! unit to which output is saved
  iscat = 1,  ! no phase correction necessary for target
  iposit = 0, ! positron flag - 0 for electron, -1 for positron
  symtyp = 2, ! D2h, C2v, etc. are of sym. type 2
  qntot  = 1,0,0, ! triplet of numbers, e.g. 1,0,0 means 1 = Singlet, 0 = A1, etc
  nelect = 8, ! number of electrons
  nob  = 85,43,43,42,43,42,42,14,  ! total number of orbitals for each symmetry
  nob0 = 1,1,1,0,1,0,0,0, ! number of target orbitals for each symmetry
  nrefo = 4, ! Number of quintets in reforb
  reforb = 0,1,2,0,0, 1,1,2,0,0, 2,1,2,0,0, 4,1,2,0,0, ! reference determinant
  lndo = 10000000, ! memory control
  gflag = 1, ! flag to group CSFs based on symmetry (1=on default)
/
&wfngrp
  gname = 'ORMAS distribution 1/1',
  qntar = -1,0,0, ! coupling control
  nelecg = 8, ! number of electrons to distribute among configurations
  nrefog = 4, ! number of reference determinants
  reforg = 0,1,2,0,0, 1,1,2,0,0, 2,1,2,0,0, 4,1,2,0,0, ! reference determinant
  ndprod = 1, ! number of sets of shells
  nelecp = 8, ! number of electrons in each set
  nshlp  = 4,  ! number of shells (triplets) in each set
  pqn  = 0,1,1, 0,1,1, 0,1,1, 0,1,1, ! orbitals in each shell
  mshl =   0,     1,     2,     4,  ! symmetry of shells above
  npcupf = 1, ! print coupling information
/
