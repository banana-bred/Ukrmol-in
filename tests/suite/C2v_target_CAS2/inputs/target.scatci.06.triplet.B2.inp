&input
  megul = 732, ! input from module CO
  nfte  = 832, ! Hamiltonian scratch file
  nfti  = 16,  ! molecular integralsNGEN
/
&cinorn
  name = 'pyridine_plus CI calculation - triplet B2',
  nstat = 4,  ! number of CI eigenvalues
  nftw = 26,  ! output file with eigenstates
  nciset = 6, ! index of calculated CI vectors within output file (0 = automatic indexing, but first must be 1)
  igh = 1,    ! force dense diagonalization
/
