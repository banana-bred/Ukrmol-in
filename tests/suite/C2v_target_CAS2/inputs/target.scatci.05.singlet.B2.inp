&input
  megul = 712, ! input from module CONGEN
  nfte  = 812, ! Hamiltonian scratch file
  nfti  = 16,  ! molecular integrals
/
&cinorn
  name = 'pyridine_plus CI calculation - singlet B2',
  nstat = 4,  ! number of CI eigenvalues
  nftw = 26,  ! output file with eigenstates
  nciset = 5, ! index of calculated CI vectors within output file (0 = automatic indexing, but first must be 1)
  igh = 1,    ! force dense diagonalization
/
