&state
  sname = 'e + trans.diazine_plus_scattering - doublet Bg',
  megul = 73, ! unit to which output is saved
  iscat = 2,  ! no phase correction necessary for target
  symtyp = 2, ! D2h, C2v, etc. are of sym. type 2
  qntot  = 2,3,0, ! triplet of numbers, e.g. 1,0,0 means 1 = Singlet, 0 = A1, etc
  nelect = 17, ! number of electrons
  nob  = 65,29,48,37, ! total number of orbitals for each symmetry
  nob0 = 11,4,10,3, ! number of target orbitals for each symmetry
  nbmx = 40000000, !Number of Mwords memory allocated for CSF generation
  nrefo = 2, ! Number of quintets in reforb
  reforb = 0,1,16,0,0, 3,1,1,0,0, ! reference determinant
  lndo = 150000000, ! memory control
  lcdo = 2000, ! memory control
/
&wfngrp
  gname = 'Ground state x continuum^1',
  qntar = 1,0,0, ! coupling control
  nelecg = 17, ! number of electrons to distribute among configurations
  nrefog = 2, ! number of reference determinants
  reforg = 0,1,16,0,0, 3,1,1,0,0, ! movable electrons
  ndprod = 3, ! number of sets of shells
  nelecp = 4,12,1, ! number of electrons in each set
  nshlp  = 2,3,1,  ! number of shells (triplets) in each set
  pqn  = 0,1,1, 0,1,1, 0,2,4, 0,1,1, 0,2,3, 0,4,5, ! orbitals in each shell
  mshl =   0,     2,     0,     1,     2,     3, ! symmetry of shells above 
  npcupf = 1, ! print coupling information
/
&wfngrp
  gname = 'Ground state x virtual^1',
  qntar = -1,0,0, ! coupling control
  nelecg = 17, ! number of electrons to distribute among configurations
  nrefog = 2, ! number of reference determinants
  reforg = 0,1,16,0,0, 3,1,1,0,0, ! movable electrons
  ndprod = 3, ! number of sets of shells
  nelecp = 4,12,1, ! number of electrons in each set
  nshlp  = 2,3,4,  ! number of shells (triplets) in each set
  pqn  = 0,1,1, 0,1,1, 0,2,4, 0,1,1, 0,2,3, 0,5,11, 0,2,4, 0,4,10, 0,1,3, ! orbitals in each shell
  mshl =   0,     2,     0,     1,     2,     0,     1,     2,     3, ! symmetry of shells above 
  npcupf = 1, ! print coupling information
/
&wfngrp
  gname = 'Core valence^-1 x virtual^2',
  qntar = -1,0,0, ! coupling control
  nelecg = 17, ! number of electrons to distribute among configurations
  nrefog = 2, ! number of reference determinants
  reforg = 0,1,16,0,0, 3,1,1,0,0, ! movable electrons
  ndprod = 3, ! number of sets of shells
  nelecp = 4,11,2, ! number of electrons in each set
  nshlp  = 2,3,4,  ! number of shells (triplets) in each set
  pqn  = 0,1,1, 0,1,1, 0,2,4, 0,1,1, 0,2,3, 0,5,11, 0,2,4, 0,4,10, 0,1,3, ! orbitals in each shell
  mshl =   0,     2,     0,     1,     2,     0,     1,     2,     3, ! symmetry of shells above 
  npcupf = 1, ! print coupling information
/
