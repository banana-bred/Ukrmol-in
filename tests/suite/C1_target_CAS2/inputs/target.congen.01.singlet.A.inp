&state
  sname = 'chlorous.acid_plus - singlet A',
  megul = 710, ! unit to which output is saved
  iscat = 1,  ! no phase correction necessary for target
  symtyp = 2, ! D2h, C2v, etc. are of sym. type 2
  qntot  = 1,0,0, ! triplet of numbers, e.g. 1,0,0 means 1 = Singlet, 0 = A1, etc
  nelect = 24, ! number of electrons
  nob  = 47, ! total number of orbitals for each symmetry
  nob0 = 47, ! number of target orbitals for each symmetry
  nbmx = 40000000, !Number of Mwords memory allocated for CSF generation
  nrefo = 1, ! Number of quintets in reforb
  reforb = 0,1,24,0,0, ! reference determinant
  lndo = 150000000, ! memory control
  lcdo = 2000, ! memory control
/
&wfngrp
  gname = 'chlorous.acid_plus - singlet A',
  qntar = -1,0,0, ! coupling control
  nelecg = 24, ! number of electrons to distribute among configurations
  nrefog = 1, ! number of reference determinants
  reforg = 0,1,24,0,0, ! movable electrons
  ndprod = 2, ! number of sets of shells
  nelecp = 20,4, ! number of electrons in each set
  nshlp  = 1,1,  ! number of shells (triplets) in each set
  pqn  = 0,1,10, 0,11,16, ! orbitals in each shell
  mshl =   0,     0, ! symmetry of shells above 
  npcupf = 1, ! print coupling information
/
