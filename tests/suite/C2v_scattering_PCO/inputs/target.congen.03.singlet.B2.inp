&state
  sname = 'Pyridine - singlet B2',
  megul = 712, ! unit to which output is saved
  iscat = 1,  ! no phase correction necessary for target
  symtyp = 2, ! D2h, C2v, etc. are of sym. type 2
  qntot  = 1,2,0, ! triplet of numbers, e.g. 1,0,0 means 1 = Singlet, 0 = A1, etc
  nelect = 42, ! number of electrons
  nob  = 65,41,46,25, ! total number of orbitals for each symmetry
  nob0 = 19,6,11,3, ! number of target orbitals for each symmetry
  nrefo = 3, ! Number of quintets in reforb
  reforb = 0,1,38,0,0, 1,1,3,0,0, 3,1,1,1,0, ! reference determinant
  lndo = 1000000000, ! memory control
/
&wfngrp
  gname = 'Pyridine - singlet B2',
  qntar = -1,0,0, ! coupling control
  nelecg = 42, ! number of electrons to distribute among configurations
  nrefog = 3, ! number of reference determinants
  reforg = 0,1,38,0,0, 1,1,3,0,0, 3,1,1,1,0, ! movable electrons
  ndprod = 1, ! number of sets of shells
  nelecp = 42, ! number of electrons in each set
  nshlp  = 4,  ! number of shells (triplets) in each set
  pqn  = 0,1,11, 0,1,2, 0,1,7, 0,1,1, ! orbitals in each shell
  mshl =   0,     1,     2,     3, ! symmetry of shells above 
  npcupf = 1, ! print coupling information
/
&wfngrp
  gname = 'Pyridine - singlet B2 GS^N-1 PCO^1',
  qntar = -1,0,0, ! coupling control
  nelecg = 42, ! number of electrons to distribute among configurations
  nrefog = 3, ! number of reference determinants
  reforg = 0,1,38,0,0, 1,1,3,0,0, 3,1,1,1,0, ! movable electrons
  ndprod = 2, ! number of sets of shells
  nelecp = 41,1, ! number of electrons in each set
  nshlp  = 4,4,  ! number of shells (triplets) in each set
  pqn  = 0,1,11, 0,1,2, 0,1,7, 0,1,1, 0,12,19, 0,3,6, 0,8,11, 0,2,3, ! orbitals in each shell
  mshl =   0,     1,     2,     3,     0,     1,     2,     3, ! symmetry of shells above 
  npcupf = 1, ! print coupling information
/
