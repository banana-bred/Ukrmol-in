&input
  megul = 710, ! input from module CONGEN
  nfte = 29, ! Hamiltonian scratch file
  ukrmolp_ints = .true., ! commented out if you do not run UKRmol+ suite
  nfti  = 16,  ! molecular integrals
/
&cinorn
  name = 'Pyridine CI calculation - singlet A1',
  nftw = 26,  ! output file with eigenstates
  nstat = 20, ! number of CI eigenvalues
  nciset = 1, ! index of calculated CI vectors within output file (0 = automatic indexing, but first must be 1)
 !igh = 1,
 !memp = 2.5,
/
