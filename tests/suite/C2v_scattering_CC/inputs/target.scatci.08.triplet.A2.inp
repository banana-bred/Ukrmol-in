&input
  megul = 733, ! input from module CONGEN
  nfte  = 833, ! Hamiltonian scratch file
  nfti  = 16,  ! molecular integrals
/
&cinorn
  name = 'pyridine_plus_scattering CI calculation - triplet A2',
  nstat = 1,  ! number of CI eigenvalues
  nftw = 26,  ! output file with eigenstates
  nciset = 8, ! index of calculated CI vectors within output file (0 = automatic indexing, but first must be 1)
  igh = 1,    ! force dense diagonalization
/
