&input
  megul = 72,  ! input from module CONGEN
  nfte  = 82,  ! Hamiltonian scratch file
  nfti  = 16,  ! molecular integrals
  icidg = 1,   !0 - do not diagonalize for parallel, 1 - do diagonalise Hamiltonian matrix for serial
  iexpc = 1,   ! prototype CI expansion flag - 1 for scattering calculation
  icitg = 1,   ! CI target flag - 1 = perform CI target contraction
  idiag = 2,   ! matrix element evaluation flag - 2 = do not evaluate pure target integrals
  nftg = 26,   ! CI target vectors switch - 0 = use scattering wavefunctions to generated (phase corrected) target wavefunctions
  ntgsym = 8,  ! number of target state symmetries (>1 in CAS calculations)
  mcont = 2,2,3,3,0,0,1,1,   ! lambda value ('symmetry') of the continuum orbitals associated with each target state
  notgt = 36,36,23,23,56,56,36,36,  ! number of continuum orbitals associated with each target symmetry
  numtgt = 2,1,1,1,1,1,1,1,  ! number of target states for each symmetries
  ntgtf = 1,1,2,3,4,5,6,7,8,  ! target state set
  ntgts = 1,2,1,1,1,1,1,1,1,  ! target state index in set
/
&cinorn
  name = 'pyridine_plus_scattering CI calculation - doublet B2',
  igh = 1,      ! force dense diagonalization
  nftw = 252,   ! output file with eigenstates
  NPFLG(1) = 0,
  NPFLG(2) = 0,
/
