&input
  megul = 735, ! input from module CONGEN
  nfte  = 835, ! Hamiltonian scratch file
  nfti  = 16,  ! molecular integrals
/
&cinorn
  name = 'benzene_plus CI calculation - triplet B2g',
  nstat = 2,  ! number of CI eigenvalues
  nftw = 26,  ! output file with eigenpairs
  nciset = 12, ! index of calculated CI vectors within output file (0 = automatic indexing, but first must be 1)
  igh = 1,    ! force dense diagonalization
/
