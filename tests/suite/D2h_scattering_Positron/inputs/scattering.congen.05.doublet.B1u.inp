  pqn  = 0,1,3, 0,1,1, 0,1,1, 0,1,2, 0,1,1, 0,1,1, 0,19,20, ! orbitals in each shell
  mshl =   0,     1,     2,     4,     5,     6,     5, ! symmetry of shells above 
