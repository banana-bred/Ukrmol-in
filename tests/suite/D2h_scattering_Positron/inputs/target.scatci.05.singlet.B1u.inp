&input
  megul = 714, ! input from module CONGEN
  nfte = 29, ! Hamiltonian scratch file
  ukrmolp_ints = .true., ! commented out if you do not run UKRmol+ suite
  nfti  = 16,  ! molecular integrals
/
&cinorn
  name = 'H2 CI calculation - singlet B1u',
  nstat = 50, ! number of CI eigenvalues
  nciset = 5, ! index of calculated CI vectors within output file (0 = automatic indexing, but first must be 1)
 !igh = 1,
 !memp = 2.5,
/
