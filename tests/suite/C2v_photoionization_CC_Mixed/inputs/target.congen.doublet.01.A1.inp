&state
  sname = 'CH4+ - doublet A1',
  megul = 720, ! unit to which output is saved
  iscat = 1,  ! no phase correction necessary for target
  symtyp = 2, ! D2h, C2v, etc. are of sym. type 2
  qntot  = 2,0,0, ! triplet of numbers, e.g. 1,0,0 means 1 = Singlet, 0 = A1, etc
  nelect = 9, ! number of electrons
  nob  = 120,79,79,50, ! total number of orbitals for each symmetry
  nob0 = 4,2,2,0, ! number of target orbitals for each symmetry
  nrefo = 2, ! Number of quintets in reforb
  reforb = 0,1,7,0,0, 1,1,2,0,0, ! reference determinant
  lndo = 10000000, ! memory control
/
&wfngrp
  gname = 'CH4+ - doublet A1',
  qntar = -1,0,0, ! coupling control
  nelecg = 9, ! number of electrons to distribute among configurations
  nrefog = 2, ! number of reference determinants
  reforg = 0,1,7,0,0, 1,1,2,0,0, ! movable electrons
  ndprod = 2, ! number of sets of shells
  nelecp = 4,5, ! number of electrons in each set
  nshlp  = 1,3,  ! number of shells (triplets) in each set
  pqn  = 0,1,2, 0,3,4, 0,1,2, 0,1,2, ! orbitals in each shell
  mshl =   0,     0,     1,     2, ! symmetry of shells above 
  npcupf = 1, ! print coupling information
/
