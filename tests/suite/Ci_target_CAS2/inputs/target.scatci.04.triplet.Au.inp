&input
  megul = 731, ! input from module CONGEN
  nfte  = 831, ! Hamiltonian scratch file
  nfti  = 16,  ! molecular integrals
/
&cinorn
  name = 'butane_plus CI calculation - triplet Au',
  nstat = 2,  ! number of CI eigenvalues
  nftw = 26,  ! output file with eigenstates
  nciset = 4, ! index of calculated CI vectors within output file (0 = automatic indexing, but first must be 1)
  igh = 1,    ! force dense diagonalization
/
