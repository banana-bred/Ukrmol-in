&state
  sname = 'e + He - singlet B2u',
  megul = 72, ! unit to which output is saved
  iscat = 2,  ! no phase correction necessary for target
  symtyp = 2, ! D2h, C2v, etc. are of sym. type 2
  qntot  = 1,2,0, ! triplet of numbers, e.g. 1,0,0 means 1 = Singlet, 0 = A1, etc
  nelect = 2, ! number of electrons
  nob  = 89,44,44,43,44,43,43,14, ! total number of orbitals for each symmetry
  nob0 = 5,2,2,1,2,1,1,0, ! number of target orbitals for each symmetry
  nrefo = 2, ! Number of quintets in reforb
  reforb = 0,1,1,0,0, 2,1,1,1,0, ! reference determinant
  lndo = 10000000, ! memory control
/
&wfngrp
  gname = 'doublet Ag x continuum^1',
  qntar = 2,0,0, ! coupling control
  nelecg = 2, ! number of electrons to distribute among configurations
  nrefog = 2, ! number of reference determinants
  reforg = 0,1,1,0,0, 2,1,1,1,0, ! movable electrons
  ndprod = 2, ! number of sets of shells
  nelecp = 1,1, ! number of electrons in each set
  nshlp  = 7,1,  ! number of shells (triplets) in each set
  pqn  = 0,1,5, 0,1,2, 0,1,2, 0,1,1, 0,1,2, 0,1,1, 0,1,1, 0,3,4, ! orbitals in each shell
  mshl =   0,     1,     2,     3,     4,     5,     6,     2, ! symmetry of shells above 
  npcupf = 1, ! print coupling information
/
&wfngrp
  gname = 'core^Nc cas^N-Nc+1',
  qntar = -1,0,0, ! coupling control
  nelecg = 2, ! number of electrons to distribute among configurations
  nrefog = 2, ! number of reference determinants
  reforg = 0,1,1,0,0, 2,1,1,1,0, ! movable electrons
  ndprod = 1, ! number of sets of shells
  nelecp = 2, ! number of electrons in each set
  nshlp  = 7,  ! number of shells (triplets) in each set
  pqn  = 0,1,5, 0,1,2, 0,1,2, 0,1,1, 0,1,2, 0,1,1, 0,1,1, ! orbitals in each shell
  mshl =   0,     1,     2,     3,     4,     5,     6, ! symmetry of shells above 
  npcupf = 1, ! print coupling information
/
