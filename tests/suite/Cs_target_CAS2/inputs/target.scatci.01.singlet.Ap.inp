&input
  megul = 710, ! input from module CONGEN
  nfte  = 810, ! Hamiltonian scratch file
  nfti  = 16,  ! molecular integrals
/
&cinorn
  name = 'uracil_plus CI calculation - singlet Ap',
  nstat = 3,  ! number of CI eigenvalues
  nftw = 26,  ! output file with eigenpairs
  nciset = 1, ! index of calculated CI vectors within output file (0 = automatic indexing, but first must be 1)
  igh = 1,    ! force dense diagonalization
/
