&input
  name = 'H2O - Transition Moments',
  ipol = 2, ! controls calculation of dipole polarizabilities, 0 = no calculation
  ntgt = 9, ! number of CSF expansions used, this is the number of different output files to be read
  nftint = 16, ! molecular integrals
  nftg = 26, ! target eigenstates
  nftsor = 7001,7002,7003,7004,7005,7006,7007,7008,7009, ! unit numbers with output from CONGEN
  ntgtf = 1,2,3,4,5,6,7,8,9, ! defines the set number, on unit NFTG where the CI vectors for this symmetry are to be found.
  ntgtl = 1,1,1,1,1,1,1,1,1, ! defines the sequence number, within the set specified by NTGTF, of the last CI vector to be used
  npflg(9) = 1, ! prints computed moments
  zlast = .true., ! when set to .true. identifies that this card deck is the last in the stack of &INPUT decks.
  ukrmolp_ints = .true., ! commented out if you do not run UKRmol+ suite
/
