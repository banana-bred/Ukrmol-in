&state
  sname = 'e + H2 - doublet B2g',
  megul = 70, ! unit to which output is saved
  iscat = 2,  ! no phase correction necessary for target
  symtyp = 2, ! D2h, C2v, etc. are of sym. type 2
  qntot  = 2,5,0, ! triplet of numbers, e.g. 1,0,0 means 1 = Singlet, 0 = A1, etc
  nelect = 3, ! number of electrons
  nob  = 100,50,50,40,54,42,42,12, ! total number of orbitals for each symmetry
  nobe = 50,25,25,20,27,21,21,6, ! total number of orbitals for each symmetry
  nobp = 50,25,25,20,27,21,21,6, ! total number of orbitals for each symmetry
  nob0 = 20,8,8,5,10,6,6,0, ! number of target orbitals for each symmetry
  nobv = 0,0,0,0,0,0,0,0, ! number of target orbitals for each symmetry
  iposit = -1,
  nrefo = 2, ! Number of quintets in reforb
  reforb = 0,1,2,0,0, 5,1,1,0,0, ! reference determinant
  lndo = 1000000000, ! memory control
  lcdo=4000,
/
&wfngrp
  gname = 'singlet Ag x continuum^1',
  qntar = 1,0,0, ! coupling control
  nelecg = 3, ! number of electrons to distribute among configurations
  nrefog = 2, ! number of reference determinants
  reforg = 0,1,2,0,0, 5,1,1,0,0, ! movable electrons
  ndprod = 2, ! number of sets of shells
  nelecp = 2,1, ! number of electrons in each set
  nshlp  = 6,1,  ! number of shells (triplets) in each set
  pqn  = 0,1,3, 0,1,1, 0,1,1, 0,1,2, 0,1,1, 0,1,1, 0,28,29, ! orbitals in each shell
  mshl =   0,     1,     2,     4,     5,     6,     5, ! symmetry of shells above 
  npcupf = 1, ! print coupling information
/
