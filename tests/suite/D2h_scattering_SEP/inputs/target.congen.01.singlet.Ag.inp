&state
  sname = 'benzene_plus_scattering - singlet Ag',
  megul = 710, ! unit to which output is saved
  iscat = 1,  ! no phase correction necessary for target
  symtyp = 2, ! D2h, C2v, etc. are of sym. type 2
  qntot  = 1,0,0, ! triplet of numbers, e.g. 1,0,0 means 1 = Singlet, 0 = A1, etc
  nelect = 42, ! number of electrons
  nob  = 48,22,26,19,28,20,22,7, ! total number of orbitals for each symmetry
  nob0 = 11,3,7,2,9,3,5,1, ! number of target orbitals for each symmetry
  nbmx = 40000000, !Number of Mwords memory allocated for CSF generation
  nrefo = 7, ! Number of quintets in reforb
  reforb = 0,1,12,0,0, 1,1,2,0,0, 2,1,8,0,0, 3,1,2,0,0, 4,1,10,0,0, 5,1,2,0,0, 6,1,6,0,0, ! reference determinant
  lndo = 150000000, ! memory control
  lcdo = 2000, ! memory control
/
&wfngrp
  gname = 'benzene_plus_scattering - singlet Ag',
  qntar = -1,0,0, ! coupling control
  nelecg = 42, ! number of electrons to distribute among configurations
  nrefog = 7, ! number of reference determinants
  reforg = 0,1,12,0,0, 1,1,2,0,0, 2,1,8,0,0, 3,1,2,0,0, 4,1,10,0,0, 5,1,2,0,0, 6,1,6,0,0, ! movable electrons
  ndprod = 2, ! number of sets of shells
  nelecp = 30,12, ! number of electrons in each set
  nshlp  = 4,6,  ! number of shells (triplets) in each set
  pqn  = 0,1,5, 0,1,4, 0,1,4, 0,1,2, 0,6,6, 0,1,1, 0,1,1, 0,5,5, 0,1,1, 0,3,3, ! orbitals in each shell
  mshl =   0,     2,     4,     6,     0,     1,     3,     4,     5,     6, ! symmetry of shells above 
  npcupf = 1, ! print coupling information
/
